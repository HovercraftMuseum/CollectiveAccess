# Copy to .env beside compose.yaml and fill in. NEVER commit .env.
# Generate passwords with:  openssl rand -base64 32
# Values containing spaces must be wrapped in double quotes.

# --- Image -------------------------------------------------------------------
# Image published by this repository's GitHub Actions workflow
# (ghcr.io/<owner>/<repository>, all lower case)
CA_IMAGE=ghcr.io/your-org/collective-access
# CollectiveAccess version to run. Change by hand only after following
# docs/upgrading.md. Runtime security rebuilds arrive under the same tag.
CA_IMAGE_TAG=2.0.11

# --- Storage -----------------------------------------------------------------
# See "Storage" in README.md. The examples assume fast storage (SSD)
# under /srv/fast and large storage (HDD) under /srv/bulk; any paths will do.

# Application data on fast storage: contains stack/, config/ and db/
CA_APPDATA=/srv/fast/appdata/collectiveaccess
# CA's media folder: uploaded access copies and derivatives
CA_MEDIA=/srv/bulk/appdata/collectiveaccess/media
# Backups: database/ (dumps) and application/ (copy of stack and config)
CA_BACKUPS=/srv/bulk/backups/collectiveaccess
# Staging folder the batch importer reads from (mounted read-only)
CA_INGEST=/srv/bulk/ingest

# Numeric user and group that own the folders above. Leave empty to use the
# image default (33, the web server user inside the container).
CA_UID=
CA_GID=

# --- Database ------------------------------------------------------------------
CA_DB_DATABASE=collectiveaccess
CA_DB_USER=collectiveaccess
CA_DB_PASSWORD=change-me
CA_DB_ROOT_PASSWORD=change-me-too
# Roughly half to two-thirds of the memory you want to give the database
CA_DB_BUFFER_POOL=1G

# --- Application -----------------------------------------------------------------
CA_APP_DISPLAY_NAME="My Collection"
CA_ADMIN_EMAIL=admin@example.org
CA_TIMEZONE=UTC
# Must exist in the chosen installation profile's locale list
CA_DEFAULT_LOCALE=en_US
# Set to true only while debugging
CA_STACKTRACE_ON_EXCEPTION=false
# Days of Providence log files that ca-prune-logs keeps
CA_LOG_KEEP_DAYS=30

# --- Network -----------------------------------------------------------------------
# Address and port the staff interface listens on. Use a LAN or VPN address
# rather than 0.0.0.0 if the host has a public interface.
CA_HTTP_BIND=0.0.0.0
CA_HTTP_PORT=8080

# --- Cache -------------------------------------------------------------------------
CA_REDIS_MAXMEMORY=512mb

# --- Outgoing email (optional) -------------------------------------------------------
CA_SMTP_SERVER=
CA_SMTP_PORT=587
CA_SMTP_USER=
CA_SMTP_PASSWORD=
# Authentication method (e.g. LOGIN, PLAIN) and encryption (TLS or SSL)
CA_SMTP_AUTH=LOGIN
CA_SMTP_SSL=TLS
