#!/bin/sh
# Delete Providence log files older than CA_LOG_KEEP_DAYS (default 30).
# Providence starts new log files every day and never removes old ones.
#
# Run it daily from the host, from the folder holding compose.yaml:
#   docker compose exec -T web ca-prune-logs
set -eu

LOG_DIR="${CA_LOG_DIR:-/var/lib/collectiveaccess/log}"
KEEP_DAYS="${CA_LOG_KEEP_DAYS:-30}"

case "$KEEP_DAYS" in
    ''|*[!0-9]*) echo "CA_LOG_KEEP_DAYS must be a whole number of days" >&2; exit 1 ;;
esac

find "$LOG_DIR" -maxdepth 1 -type f -name 'log_*.txt' -mtime +"$KEEP_DAYS" -print -delete
